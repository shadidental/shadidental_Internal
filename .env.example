# ── Database ───────────────────────────────────────────────────────────────
# Supabase (testing): Project Settings → Database → Connection string.
#   DATABASE_URL = "Transaction pooler" string (port 6543) + ?pgbouncer=true&connection_limit=5
#   DIRECT_URL   = "Session pooler" or direct string (port 5432) – used for migrations
# Own server (go-live): both can be the same plain PostgreSQL URL.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── App ────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# At least 32 random characters. Generate with:  openssl rand -base64 48
# Changing it later invalidates everyone's authenticator setup.
APP_SECRET=""
ORG_NAME="Shadi International Dental Center"
ORG_SHORT_NAME="SIDC"
ASSET_TAG_PREFIX="SIDC"
SESSION_HOURS=10
MFA_REQUIRED=true

# ── Email (Roundcube mailbox → its SMTP server) ────────────────────────────
IT_MAILBOX="it@yourclinic.ae"       # receives HR requests; sender of portal emails
HR_MAILBOX="hr@yourclinic.ae"       # copied on every request email (optional)
MAIL_FROM="it@yourclinic.ae"
# "log" prints emails to the server console instead of sending (local testing).
EMAIL_TRANSPORT="smtp"
SMTP_HOST="mail.yourclinic.ae"
SMTP_PORT=587
SMTP_SECURE=false                   # true for port 465
SMTP_USER="it@yourclinic.ae"
SMTP_PASSWORD=""
